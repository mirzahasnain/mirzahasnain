# Economic calendar provider: mock | trading-economics
ECONOMIC_PROVIDER=mock

# TradingEconomics credentials (server-only — never expose to the client)
TRADING_ECONOMICS_KEY=
TRADING_ECONOMICS_SECRET=

# Optional tuning
ECONOMIC_CALENDAR_REFRESH_MS=60000
ECONOMIC_CALENDAR_MAX_RETRIES=3

# Public app URL (safe for client)
NEXT_PUBLIC_APP_URL=http://localhost:3000
